{
    "use_gpu": 0,
    "loss": "ema",
    "optim": "adam",
    "optim_config": {
        "lr": 1e-5
    },
    "scheduler_config": {
        "factor": 0.75,
        "patience": 5,
        "min_lr": 5e-06
    },
    "sampler": "shuffle",
    "sampler_config": {
        "static": false,
        "static_shuffle": true
    },
    "batch_size": 16,
    "shuffle": true,
    "epochs": 1000,

    "validate": true,
    "do_es": true,
    "patience": 10,
    "es_metric": "val_acc",

    "save_last": true,
    "save_best": true
}
